# deploy/vm/api.env 로 복사해 서버에서만 값을 채운다(git에 올리지 않음, 권한 600)
# PORT·TRUST_PROXY는 compose.yaml이 넣는다
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
BRIA_API_TOKEN=
OPS_METRICS_TOKEN=
ALLOW_TOKENLESS_GUEST=false
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_DAILY_LIMIT=300
# 모바일 웹 조사: 참가자들이 같은 Wi-Fi(공인 IP 1개)에서 로그인 전 분석(익명 세션)을 하면 IP 한도를 함께 쓴다.
# 기본 30/시간은 부족할 수 있어 올린다. 비용 상한은 GEMINI_DAILY_LIMIT가 지킨다
IP_ANALYZE_LIMIT_PER_HOUR=120
# 웹 화면을 다른 도메인에 둘 때만 그 주소(쉼표 구분). 같은 도메인(/api)이면 필요 없음
ALLOWED_ORIGINS=
# 넣지 않음: FAL_KEY, GEMINI_REQUEST_MASK
