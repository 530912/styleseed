{
 "contract": "styleseed-fashion-knowledge",
 "contract_version": "0.1.0",
 "status": "draft",
 "owner": "Claude A (추천엔진·Data Contract). 패션 의미(허용값·규칙·평가 기준) 최종 승인: 공동창업자 2명",
 "format": {
  "encoding": "UTF-8 (BOM 허용)",
  "file": "CSV, RFC 4180, 1행 = 헤더",
  "header": "필드 키 그대로(예: rule_id) 또는 '한국어 이름 [rule_id]'. 대괄호 안의 키로 읽는다",
  "list_separator": "|",
  "date": "YYYY-MM-DD",
  "enum_values": "고정 목록은 영어 키가 정식 값. 한국어 라벨도 같은 값으로 받아 영어 키로 바꾼다",
  "unknown_fields": "x_로 시작하는 열은 Lab 전용으로 조용히 무시, 그 밖의 모르는 열은 경고 후 무시"
 },
 "lists": {
  "data_origin": [["human", "사람"], ["example", "예시"], ["claude_draft", "Claude 초안"]],
  "taxonomy_status": [["proposed", "제안"], ["in_review", "검토중"], ["confirmed", "확정"], ["retired", "폐기"]],
  "approval_status": [["draft", "초안"], ["in_review", "검토중"], ["approved", "승인"], ["on_hold", "보류"], ["retired", "폐기"]],
  "rule_type": [["base", "기본"], ["exception", "예외"]],
  "dimension": [["color", "색"], ["silhouette_fit", "핏·실루엣"], ["material_season", "소재·계절"], ["tpo", "TPO"], ["mood", "무드"]],
  "review_dimension": [["color", "색"], ["silhouette_fit", "핏·실루엣"], ["material_season", "소재·계절"], ["tpo", "TPO"], ["mood", "무드"], ["overall", "종합"]],
  "judgement": [["recommended", "권장"], ["conditional", "조건부 권장"], ["caution", "주의"], ["not_recommended", "비권장"]],
  "confidence": [["high", "High"], ["medium", "Medium"], ["low", "Low"]],
  "label": [["suitable", "적합"], ["conditional", "조건부"], ["unsuitable", "부적합"]],
  "recommendable": [["yes", "예"], ["no", "아니오"], ["unsure", "모름"]],
  "yes_no": [["yes", "예"], ["no", "아니오"]],
  "app_supported": [["yes", "예"], ["converted", "변환"], ["no", "아니오"]],
  "submission_status": [["in_progress", "작성중"], ["submitted", "제출"]],
  "weather": [["cold", "추움(5℃ 이하)"], ["cool", "선선(6~15℃)"], ["mild", "온화(16~22℃)"], ["warm", "따뜻(23~27℃)"], ["hot", "더움(28℃ 이상)"], ["rain", "비"], ["snow", "눈"]],
  "outfit_set": [["pilot", "Pilot"], ["main", "본 평가"]],
  "split": [["unassigned", "미배정"], ["dev", "개발용"], ["holdout", "보류용"]],
  "outfit_status": [["active", "사용"], ["retired", "폐기"]],
  "evaluator_role": [["cofounder", "공동창업자"], ["external", "외부 평가자"]],
  "garment_source": [["fixture", "고정 옷장"], ["product_image", "상품 이미지"], ["qa_upload", "QA 업로드"], ["other", "기타"]],
  "color_tone": [["bright", "bright"], ["light", "light"], ["muted", "muted"], ["dark", "dark"], ["vivid", "vivid"]],
  "app_field": [["category", "category"], ["subCategory", "subCategory"], ["color", "color"], ["colorTone", "colorTone"], ["fit", "fit"], ["material", "material"], ["season", "season"], ["tpo", "tpo"], ["style", "style"], ["none", "없음"]],
  "attribute_key": [["category", "대분류"], ["subcategory", "세부분류"], ["main_color", "주색상"], ["value", "명도"], ["saturation", "채도"], ["fit", "핏"], ["silhouette", "실루엣"], ["material", "소재(섬유)"], ["material_feel", "소재감"], ["thickness", "두께감"], ["season", "계절"], ["tpo", "TPO"], ["mood", "무드"]],
  "review_cause": [["criteria", "기준 해석 차이"], ["missing_info", "정보 부족(사진·설명)"], ["taste", "취향 차이"], ["input_error", "입력 실수"], ["needs_rule", "규칙 필요"]],
  "review_action": [["add_rule", "규칙 추가"], ["edit_rule", "규칙 수정"], ["edit_rubric", "평가 기준 문장 수정"], ["add_exception", "예외 추가"], ["none", "조치 없음"]],
  "review_status": [["open", "미검토"], ["discussing", "논의중"], ["agreed", "합의"], ["on_hold", "보류"]]
 },
 "rule_id_prefix": {"color": "COL", "silhouette_fit": "FIT", "material_season": "MAT", "tpo": "TPO", "mood": "MOOD"},
 "entities": {
  "evaluators": {
   "file": "evaluators.csv",
   "title_ko": "평가자·승인자",
   "key": ["evaluator_id"],
   "fields": [
    {"key": "evaluator_id", "label": "평가자 ID", "type": "id", "pattern": "^E[0-9]{1,2}$", "required": true, "example": "E1", "desc": "이름 대신 쓰는 ID. 개인정보(이름·이메일)는 넣지 않는다"},
    {"key": "role", "label": "역할", "type": "enum", "list": "evaluator_role", "required": true, "example": "cofounder"},
    {"key": "can_approve", "label": "승인 권한", "type": "enum", "list": "yes_no", "required": true, "example": "yes", "desc": "규칙 승인·속성 확정 권한. V0.1은 공동창업자만 yes"},
    {"key": "active", "label": "활성", "type": "enum", "list": "yes_no", "required": true, "example": "yes"},
    {"key": "note", "label": "메모", "type": "text", "required": false}
   ]
  },
  "attribute_values": {
   "file": "garment_schema.csv",
   "title_ko": "의류 속성 사전(허용값)",
   "key": ["attribute_key", "value_key"],
   "fields": [
    {"key": "attribute_key", "label": "속성 키", "type": "enum", "list": "attribute_key", "required": true, "example": "fit"},
    {"key": "attribute_ko", "label": "속성 이름", "type": "text", "required": true, "example": "핏"},
    {"key": "value_key", "label": "값 키", "type": "id", "pattern": "^[A-Za-z][A-Za-z0-9-]*$", "required": true, "example": "oversized", "desc": "규칙·의류에서 쓰는 값. 확정 후 바꾸지 않는다(바꾸려면 폐기 후 새 값)"},
    {"key": "value_ko", "label": "값 이름", "type": "text", "required": true, "example": "오버사이즈"},
    {"key": "parent_value", "label": "상위 값", "type": "string", "required": "attribute_key=subcategory", "example": "top", "desc": "세부분류가 속한 대분류 값 키"},
    {"key": "definition", "label": "정의", "type": "text", "required": false},
    {"key": "guide", "label": "판단 기준", "type": "text", "required": false},
    {"key": "example", "label": "예시", "type": "text", "required": false},
    {"key": "app_field", "label": "앱 필드", "type": "enum", "list": "app_field", "required": true, "example": "fit", "desc": "현재 앱 Clothing 타입의 필드. 대응 없음은 none"},
    {"key": "app_value", "label": "현재 앱 값", "type": "string", "required": false, "example": "oversized"},
    {"key": "app_supported", "label": "앱 지원", "type": "enum", "list": "app_supported", "required": true, "example": "yes", "desc": "yes=앱이 저장 / converted=다른 앱 값에서 변환 / no=앱이 아직 모름"},
    {"key": "status", "label": "상태", "type": "enum", "list": "taxonomy_status", "required": true, "example": "confirmed"},
    {"key": "decided_by", "label": "결정자", "type": "ref_list", "ref": "evaluators", "required": "status=confirmed", "example": "E1|E2"},
    {"key": "decided_at", "label": "결정일", "type": "date", "required": "status=confirmed", "example": "2026-10-22"},
    {"key": "data_origin", "label": "데이터 출처", "type": "enum", "list": "data_origin", "required": true, "example": "human"},
    {"key": "version", "label": "버전", "type": "int", "min": 1, "required": true, "example": "1"},
    {"key": "note", "label": "메모", "type": "text", "required": false}
   ]
  },
  "garments": {
   "file": "garments.csv",
   "title_ko": "평가용 의류",
   "key": ["garment_id"],
   "fields": [
    {"key": "garment_id", "label": "의류 ID", "type": "id", "pattern": "^(G[0-9]{3,5}|EX-G[0-9]{2,3})$", "required": true, "example": "G001"},
    {"key": "name_ko", "label": "이름", "type": "text", "required": true, "example": "화이트 오버핏 면 셔츠"},
    {"key": "image_url", "label": "이미지 링크", "type": "url", "required": false, "desc": "팀이 접근 가능한 https 링크"},
    {"key": "source", "label": "출처", "type": "enum", "list": "garment_source", "required": true, "example": "fixture"},
    {"key": "source_ref", "label": "출처 참조", "type": "string", "required": false, "example": "engine-closet#1", "desc": "엔진 기준선 측정용 원본 참조"},
    {"key": "category", "label": "대분류", "type": "enum", "taxonomy": "category", "required": true, "example": "top"},
    {"key": "subcategory", "label": "세부분류", "type": "enum", "taxonomy": "subcategory", "required": true, "example": "shirt"},
    {"key": "main_color", "label": "주색상", "type": "enum", "taxonomy": "main_color", "required": true, "example": "white"},
    {"key": "color_tone", "label": "색 톤(앱)", "type": "enum", "list": "color_tone", "required": true, "example": "bright", "desc": "현재 앱 colorTone. 명도·채도가 없을 때 변환에 쓴다"},
    {"key": "value", "label": "명도", "type": "enum", "taxonomy": "value", "required": false, "example": "light"},
    {"key": "saturation", "label": "채도", "type": "enum", "taxonomy": "saturation", "required": false, "example": "low"},
    {"key": "fit", "label": "핏", "type": "enum", "taxonomy": "fit", "required": true, "example": "oversized"},
    {"key": "silhouette", "label": "실루엣", "type": "enum", "taxonomy": "silhouette", "required": false, "example": "H"},
    {"key": "material", "label": "소재(섬유)", "type": "enum", "taxonomy": "material", "required": true, "example": "cotton"},
    {"key": "material_feel", "label": "소재감", "type": "enum_list", "taxonomy": "material_feel", "required": false, "example": "crisp|matte"},
    {"key": "thickness", "label": "두께감", "type": "enum", "taxonomy": "thickness", "required": false, "example": "medium"},
    {"key": "season", "label": "계절", "type": "enum_list", "taxonomy": "season", "required": true, "example": "spring|fall"},
    {"key": "tpo", "label": "TPO", "type": "enum_list", "taxonomy": "tpo", "required": true, "example": "casual|office"},
    {"key": "mood", "label": "무드", "type": "enum_list", "taxonomy": "mood", "required": true, "example": "minimal|classic"},
    {"key": "attribute_status", "label": "속성 확인 상태", "type": "enum", "list": "taxonomy_status", "required": true, "example": "proposed", "desc": "속성 태깅을 사람이 확인했는지"},
    {"key": "labeled_by", "label": "태깅한 사람", "type": "ref_list", "ref": "evaluators", "required": "attribute_status=confirmed", "example": "E1"},
    {"key": "data_origin", "label": "데이터 출처", "type": "enum", "list": "data_origin", "required": true, "example": "claude_draft"},
    {"key": "note", "label": "메모", "type": "text", "required": false}
   ]
  },
  "outfits": {
   "file": "outfits.csv",
   "title_ko": "평가용 코디",
   "key": ["outfit_id"],
   "fields": [
    {"key": "outfit_id", "label": "코디 ID", "type": "id", "pattern": "^(P[0-9]{2,3}|M[0-9]{3,4}|EX-[0-9]{2})$", "required": true, "example": "P01", "desc": "P=Pilot, M=본 평가, EX-=예시"},
    {"key": "set", "label": "세트", "type": "enum", "list": "outfit_set", "required": true, "example": "pilot"},
    {"key": "split", "label": "용도", "type": "enum", "list": "split", "required": true, "example": "unassigned", "desc": "가중치 조정용(dev) / 최종 확인용(holdout). 확정 후 바꾸지 않는다"},
    {"key": "context_label", "label": "평가 상황", "type": "text", "required": true, "example": "가을 · 출근"},
    {"key": "context_tpo", "label": "상황 TPO", "type": "enum", "taxonomy": "tpo", "required": true, "example": "office"},
    {"key": "context_season", "label": "상황 계절", "type": "enum", "taxonomy": "season", "required": true, "example": "fall"},
    {"key": "context_weather", "label": "상황 날씨", "type": "enum", "list": "weather", "required": false, "example": "snow"},
    {"key": "garment_ids", "label": "의류 ID 목록", "type": "ref_list", "ref": "garments", "required": true, "min_items": 2, "max_items": 6, "example": "G001|G005|G013"},
    {"key": "image_url", "label": "코디 이미지 링크", "type": "url", "required": false},
    {"key": "status", "label": "상태", "type": "enum", "list": "outfit_status", "required": true, "example": "active"},
    {"key": "data_origin", "label": "데이터 출처", "type": "enum", "list": "data_origin", "required": true, "example": "claude_draft", "desc": "코디 구성을 누가 만들었는지(평가 점수의 출처와 별개)"},
    {"key": "note", "label": "메모", "type": "text", "required": false}
   ]
  },
  "outfit_evaluations": {
   "file": "evaluations/*.csv",
   "title_ko": "코디 평가(평가자별 독립)",
   "key": ["outfit_id", "evaluator_id", "round"],
   "fields": [
    {"key": "outfit_id", "label": "코디 ID", "type": "ref", "ref": "outfits", "required": true, "example": "P01"},
    {"key": "evaluator_id", "label": "평가자 ID", "type": "ref", "ref": "evaluators", "required": "submission_status=submitted", "example": "E1"},
    {"key": "round", "label": "평가 회차", "type": "int", "min": 1, "required": true, "example": "1", "desc": "같은 코디를 다시 평가할 때 2, 3 …(이전 회차는 고치지 않음)"},
    {"key": "outfit_summary", "label": "코디 내용(표시용)", "type": "text", "required": false, "display_only": true, "desc": "시트에서 보기 편하게 둔 열. 가져올 때 무시"},
    {"key": "score_color", "label": "색 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "4"},
    {"key": "score_silhouette_fit", "label": "핏·실루엣 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "3"},
    {"key": "score_material_season", "label": "소재·계절 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "4"},
    {"key": "score_tpo", "label": "TPO 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "2"},
    {"key": "score_mood", "label": "무드 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "4"},
    {"key": "score_overall", "label": "종합 1~5", "type": "int", "min": 1, "max": 5, "required": "submission_status=submitted", "example": "3", "desc": "다른 점수의 평균이 아니라 직접 판단"},
    {"key": "label", "label": "판정", "type": "enum", "list": "label", "required": "submission_status=submitted", "example": "conditional"},
    {"key": "recommendable", "label": "추천해도 되나", "type": "enum", "list": "recommendable", "required": "submission_status=submitted", "example": "no"},
    {"key": "reason", "label": "핵심 이유", "type": "text", "min_length": 10, "required": "submission_status=submitted", "example": "출근 상황인데 민소매 탑은 노출이 많아 격식이 부족함"},
    {"key": "improvement", "label": "바꾸면 좋을 아이템", "type": "text", "required": false, "example": "민소매 탑 → 흰 셔츠"},
    {"key": "confidence", "label": "확신도", "type": "enum", "list": "confidence", "required": "submission_status=submitted", "example": "medium"},
    {"key": "rated_at", "label": "평가일", "type": "date", "required": "submission_status=submitted", "example": "2026-10-21"},
    {"key": "submission_status", "label": "제출 상태", "type": "enum", "list": "submission_status", "required": true, "example": "submitted", "desc": "제출한 평가만 비교·집계에 쓴다"},
    {"key": "data_origin", "label": "데이터 출처", "type": "enum", "list": "data_origin", "required": true, "example": "human"},
    {"key": "note", "label": "메모", "type": "text", "required": false}
   ]
  },
  "styling_rules": {
   "file": "styling_rules.csv",
   "title_ko": "스타일링 규칙",
   "key": ["rule_id", "rule_version"],
   "fields": [
    {"key": "rule_id", "label": "규칙 ID", "type": "id", "pattern": "^(EX-)?(COL|FIT|MAT|TPO|MOOD)-[0-9]{3}$", "required": true, "example": "FIT-001", "desc": "평가 차원 약자 + 세 자리. EX-는 예시"},
    {"key": "rule_version", "label": "버전", "type": "int", "min": 1, "required": true, "example": "1", "desc": "승인된 규칙을 바꿀 때는 새 행 + 버전 증가(기존 행 수정 금지)"},
    {"key": "rule_type", "label": "규칙 종류", "type": "enum", "list": "rule_type", "required": true, "example": "base"},
    {"key": "exception_of", "label": "대상 기본 규칙", "type": "string", "required": "rule_type=exception", "example": "FIT-002"},
    {"key": "dimension", "label": "평가 차원", "type": "enum", "list": "dimension", "required": true, "example": "silhouette_fit"},
    {"key": "a_category", "label": "조건 A 대분류", "type": "enum", "taxonomy": "category", "allow": ["any"], "required": true, "example": "top"},
    {"key": "a_attribute", "label": "조건 A 속성", "type": "enum", "list": "attribute_key", "required": true, "example": "fit"},
    {"key": "a_values", "label": "조건 A 값", "type": "taxonomy_values", "attribute_field": "a_attribute", "required": true, "example": "oversized"},
    {"key": "b_category", "label": "조건 B 대분류", "type": "enum", "taxonomy": "category", "allow": ["any"], "required": false, "example": "bottom"},
    {"key": "b_attribute", "label": "조건 B 속성", "type": "enum", "list": "attribute_key", "required": false, "example": "silhouette"},
    {"key": "b_values", "label": "조건 B 값", "type": "taxonomy_values", "attribute_field": "b_attribute", "required": false, "example": "wide"},
    {"key": "context_tpo", "label": "적용 TPO", "type": "enum_list", "taxonomy": "tpo", "required": false, "example": "office|date"},
    {"key": "context_mood", "label": "적용 무드", "type": "enum_list", "taxonomy": "mood", "required": false, "example": "street"},
    {"key": "context_season", "label": "적용 계절", "type": "enum_list", "taxonomy": "season", "required": false, "example": "winter"},
    {"key": "context_weather", "label": "적용 날씨", "type": "enum_list", "list": "weather", "required": false, "example": "cold|snow"},
    {"key": "judgement", "label": "판정", "type": "enum", "list": "judgement", "required": true, "example": "caution"},
    {"key": "strength", "label": "강도 1~5", "type": "int", "min": 1, "max": 5, "required": true, "example": "3"},
