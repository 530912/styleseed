{
 "contract": "styleseed-round1-research-events",
 "contract_version": "0.2.0",
 "status": "draft",
 "experiment_id": "r1-plus-price-v1",
 "note": "연구용 실험 이벤트 형식. 실제 구독·결제·매출 이벤트(PRD 24.3 Phase 5)와 이름·저장소를 공유하지 않는다. 상세: docs/round1/PLUS_PRICING_EXPERIMENT.md 5장 | v0.2(2026-10-26): 핵심 흐름 이벤트(kind=core) 추가. 앱은 연구 모드(EXPO_PUBLIC_RESEARCH_MODE=true)에서만 기기에 기록하고 진행자가 내보낸다(src/lib/researchEvents.ts). 사진·위치·계정 정보는 담지 않는다",
 "groups": {
  "A": 2900,
  "B": 4900,
  "C": 6900
 },
 "participant_code_pattern": "^R1-[PT][0-9]{2}$",
 "rehearsal_code_prefix": "R1-T",
 "test_env": [
  "research",
  "rehearsal",
  "qa",
  "dev"
 ],
 "analysis_env": "research",
 "platform": [
  "ios",
  "android",
  "web"
 ],
 "events": {
  "experiment_assigned": {
   "kind": "plus",
   "once": true,
   "properties": {
    "consent_version": "string",
    "assignment_table_hash": "string"
   }
  },
  "plus_feature_viewed": {
   "kind": "plus",
   "once": true,
   "properties": {
    "matching_items": "int",
    "new_outfits": "int",
    "has_similar_item": "bool"
   }
  },
  "paywall_viewed": {
   "kind": "plus",
   "once": true,
   "properties": {}
  },
  "subscription_interest_selected": {
   "kind": "plus",
   "once": true,
   "choice": true,
   "properties": {
    "elapsed_ms": "int"
   }
  },
  "subscription_declined": {
   "kind": "plus",
   "once": true,
   "choice": true,
   "properties": {
    "elapsed_ms": "int",
    "reason": "decline_reason"
   }
  },
  "interview_completed": {
   "kind": "plus",
   "once": true,
   "properties": {
    "interviewer_role": "interviewer_role"
   }
  },
  "product_impression": {
