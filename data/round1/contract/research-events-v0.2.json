   "once": false,
   "properties": {
    "product_id": "string",
    "brand_id": "string",
    "source": "commerce_source"
   }
  },
  "product_clicked": {
   "kind": "commerce",
   "once": false,
   "properties": {
    "product_id": "string",
    "brand_id": "string",
    "source": "commerce_source"
   }
  },
  "official_store_opened": {
   "kind": "commerce",
   "once": false,
   "properties": {
    "product_id": "string",
    "brand_id": "string",
    "utm_applied": "bool"
   }
  },
  "app_opened": {
   "kind": "core",
   "once": false,
   "properties": {}
  },
  "register_started": {
   "kind": "core",
   "once": false,
   "properties": {}
  },
  "analysis_started": {
   "kind": "core",
   "once": false,
   "properties": {}
  },
  "analysis_completed": {
   "kind": "core",
   "once": false,
   "properties": {
    "duration_ms": "int",
    "category": "category"
   }
  },
  "analysis_failed": {
