{
 "contract": "styleseed-round1-research-events",
 "contract_version": "0.1.0",
 "status": "draft",
 "experiment_id": "r1-plus-price-v1",
 "note": "연구용 실험 이벤트 형식. 실제 구독·결제·매출 이벤트(PRD 24.3 Phase 5)와 이름·저장소를 공유하지 않는다. 상세: docs/round1/PLUS_PRICING_EXPERIMENT.md 5장",
 "groups": { "A": 2900, "B": 4900, "C": 6900 },
 "participant_code_pattern": "^R1-[PT][0-9]{2}$",
 "rehearsal_code_prefix": "R1-T",
 "test_env": ["research", "rehearsal", "qa", "dev"],
 "analysis_env": "research",
 "platform": ["ios", "android", "web"],
 "events": {
  "experiment_assigned": { "kind": "plus", "once": true, "properties": { "consent_version": "string", "assignment_table_hash": "string" } },
  "plus_feature_viewed": { "kind": "plus", "once": true, "properties": { "matching_items": "int", "new_outfits": "int", "has_similar_item": "bool" } },
  "paywall_viewed": { "kind": "plus", "once": true, "properties": {} },
  "subscription_interest_selected": { "kind": "plus", "once": true, "choice": true, "properties": { "elapsed_ms": "int" } },
  "subscription_declined": { "kind": "plus", "once": true, "choice": true, "properties": { "elapsed_ms": "int", "reason": "decline_reason" } },
  "interview_completed": { "kind": "plus", "once": true, "properties": { "interviewer_role": "interviewer_role" } },
  "product_impression": { "kind": "commerce", "once": false, "properties": { "product_id": "string", "brand_id": "string", "source": "commerce_source" } },
  "product_clicked": { "kind": "commerce", "once": false, "properties": { "product_id": "string", "brand_id": "string", "source": "commerce_source" } },
  "official_store_opened": { "kind": "commerce", "once": false, "properties": { "product_id": "string", "brand_id": "string", "utm_applied": "bool" } }
 },
 "enums": {
  "decline_reason": ["price", "not_needed", "trust", "other", "skipped"],
  "interviewer_role": ["PO", "E1", "E2"],
  "commerce_source": ["missing_item", "core", "plus_result"]
 },
 "common_fields": {
  "event_id": "uuid",
  "experiment_id": "string",
  "event_name": "event",
  "participant_code": "code",
  "experiment_group": "group",
  "displayed_price_krw": "price",
  "occurred_at": "datetime",
  "feature_version": "string",
  "app_version": "string",
  "test_env": "test_env",
  "platform": "platform",
  "session_id": "uuid"
 },
 "forbidden_fields": ["user_id", "email", "name", "phone", "photo", "image", "location", "latitude", "longitude", "device_id", "free_text"],
 "funnel_order": ["experiment_assigned", "plus_feature_viewed", "paywall_viewed", "choice", "interview_completed"]
}
