# STYLESEED 환경변수 목록 (값 없음)
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다(.gitignore).
# 앱(Expo)과 백엔드(backend/server.js)가 같은 루트 .env를 읽는다.

# --- 앱 (EXPO_PUBLIC_ 값은 앱 번들에 포함되므로 공개해도 되는 값만 넣는다) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 선택: 백엔드 주소. 비우면 http://localhost:3001 (실기기는 PC의 LAN 주소 또는 배포 주소)
EXPO_PUBLIC_API_URL=
# 선택: 프로토타입 화면(IDEAL STYLE·Core·/demo) 표시. 연구·배포 빌드에는 넣지 않는다(기본 숨김). 영상 촬영 빌드만 true
EXPO_PUBLIC_SHOW_PROTOTYPES=
# 선택: 사용자 조사 빌드만 true(기기 내 이벤트 기록·진행자 화면 /research). 그 외 빌드는 비움
EXPO_PUBLIC_RESEARCH_MODE=

# --- 백엔드 비밀값 (서버에만 둔다) ---
GEMINI_API_KEY=
BRIA_API_TOKEN=
FAL_KEY=

# --- 백엔드 선택 설정 (비우면 기본값) ---
# Gemini 모델·추론 수준 (기본 gemini-3.6-flash / minimal)
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
# Gemini에 윤곽(mask) 좌표도 요청할지 (기본 false — 앱이 쓰지 않아 Sprint 1A-3에서 끔). true면 이전 방식
GEMINI_REQUEST_MASK=
# 서버 포트 (기본 3001)
PORT=
# 웹 빌드에서 허용할 Origin, 쉼표 구분 (기본 http://localhost:8081)
ALLOWED_ORIGINS=
# 토큰 없는 분석 허용 여부 — 임시 호환 모드 (기본 true). 익명 세션 안정화 후 false
ALLOW_TOKENLESS_GUEST=
# AI 분석 시간당 한도 (기본: 익명 30 / 로그인 30 / IP 30 / 토큰 없는 guest 10). 운영은 비용 기준으로 따로 지정
ANON_ANALYZE_LIMIT_PER_HOUR=
USER_ANALYZE_LIMIT_PER_HOUR=
IP_ANALYZE_LIMIT_PER_HOUR=
GUEST_ANALYZE_LIMIT_PER_HOUR=
# 서버 전체 Gemini 호출 일일 상한(한국 시간 자정 초기화, 서버 메모리). 비우면 끔. 조사·운영은 지정 권장
GEMINI_DAILY_LIMIT=
# 이미지 처리 4경로 사용자별 시간당 한도 (기본 60)
IMAGE_TASK_LIMIT_PER_HOUR=
# SlimSAM 동시 처리 수 / 대기열 길이 / 대기 최대 시간(ms) (기본 1 / 4 / 45000). 넘치면 503 CUTOUT_BUSY → 앱은 BRIA로 대체
SLIMSAM_CONCURRENCY=
SLIMSAM_MAX_QUEUE=
SLIMSAM_QUEUE_WAIT_MS=
# 리버스 프록시 단계 수. 프록시 뒤에 배포할 때만 지정 (기본 0 = 프록시 헤더 무시)
TRUST_PROXY=
# 요청 본문 크기 제한 (기본 분석 10mb / 이미지 처리 1mb)
ANALYZE_BODY_LIMIT=
IMAGE_TASK_BODY_LIMIT=
# 외부 호출 제한 시간, 밀리초 (기본 Gemini 25000 / BRIA 45000 / 이미지 다운로드 15000)
GEMINI_TIMEOUT_MS=
BRIA_TIMEOUT_MS=
IMAGE_DOWNLOAD_TIMEOUT_MS=
# 선택: 백엔드 전용 Supabase 값. 비우면 EXPO_PUBLIC_SUPABASE_* 값을 쓴다
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- 출시 준비 (Beta Launch, docs/launch/BACKEND_DEPLOY.md · EAS_SETUP.md) ---
# 백엔드 비밀값: 계정 삭제용 Supabase 관리자 키(sb_secret_...). 서버 환경변수로만 둔다. 비우면 계정 삭제가 503
SUPABASE_SECRET_KEY=
# 선택: 계정 삭제 직전 비밀번호 재확인 유효 시간(초, 기본 600) / 웹 삭제 페이지 IP당 시간당 시도 횟수(기본 5)
ACCOUNT_DELETE_REAUTH_MAX_AGE_SECONDS=
ACCOUNT_DELETE_WEB_ATTEMPTS_PER_HOUR=
# 선택: 웹 삭제 페이지에 표시할 문의 이메일(확정 전에는 비워 둔다)
SUPPORT_EMAIL=
# 선택(배포 검증 기간): /healthz에 X-Ops-Token으로 메모리·재시작 지표를 여는 비밀 토큰(32자 이상). 검증 후 교체·삭제
OPS_METRICS_TOKEN=
# 앱: 정책 문서 주소(https). 비우면 앱에 "준비 중"으로 표시
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# 앱: Gemini 유료 등급으로 전환한 빌드에서만 true (무료 등급 고지 문구를 숨김)
EXPO_PUBLIC_GEMINI_PAID_TIER=
